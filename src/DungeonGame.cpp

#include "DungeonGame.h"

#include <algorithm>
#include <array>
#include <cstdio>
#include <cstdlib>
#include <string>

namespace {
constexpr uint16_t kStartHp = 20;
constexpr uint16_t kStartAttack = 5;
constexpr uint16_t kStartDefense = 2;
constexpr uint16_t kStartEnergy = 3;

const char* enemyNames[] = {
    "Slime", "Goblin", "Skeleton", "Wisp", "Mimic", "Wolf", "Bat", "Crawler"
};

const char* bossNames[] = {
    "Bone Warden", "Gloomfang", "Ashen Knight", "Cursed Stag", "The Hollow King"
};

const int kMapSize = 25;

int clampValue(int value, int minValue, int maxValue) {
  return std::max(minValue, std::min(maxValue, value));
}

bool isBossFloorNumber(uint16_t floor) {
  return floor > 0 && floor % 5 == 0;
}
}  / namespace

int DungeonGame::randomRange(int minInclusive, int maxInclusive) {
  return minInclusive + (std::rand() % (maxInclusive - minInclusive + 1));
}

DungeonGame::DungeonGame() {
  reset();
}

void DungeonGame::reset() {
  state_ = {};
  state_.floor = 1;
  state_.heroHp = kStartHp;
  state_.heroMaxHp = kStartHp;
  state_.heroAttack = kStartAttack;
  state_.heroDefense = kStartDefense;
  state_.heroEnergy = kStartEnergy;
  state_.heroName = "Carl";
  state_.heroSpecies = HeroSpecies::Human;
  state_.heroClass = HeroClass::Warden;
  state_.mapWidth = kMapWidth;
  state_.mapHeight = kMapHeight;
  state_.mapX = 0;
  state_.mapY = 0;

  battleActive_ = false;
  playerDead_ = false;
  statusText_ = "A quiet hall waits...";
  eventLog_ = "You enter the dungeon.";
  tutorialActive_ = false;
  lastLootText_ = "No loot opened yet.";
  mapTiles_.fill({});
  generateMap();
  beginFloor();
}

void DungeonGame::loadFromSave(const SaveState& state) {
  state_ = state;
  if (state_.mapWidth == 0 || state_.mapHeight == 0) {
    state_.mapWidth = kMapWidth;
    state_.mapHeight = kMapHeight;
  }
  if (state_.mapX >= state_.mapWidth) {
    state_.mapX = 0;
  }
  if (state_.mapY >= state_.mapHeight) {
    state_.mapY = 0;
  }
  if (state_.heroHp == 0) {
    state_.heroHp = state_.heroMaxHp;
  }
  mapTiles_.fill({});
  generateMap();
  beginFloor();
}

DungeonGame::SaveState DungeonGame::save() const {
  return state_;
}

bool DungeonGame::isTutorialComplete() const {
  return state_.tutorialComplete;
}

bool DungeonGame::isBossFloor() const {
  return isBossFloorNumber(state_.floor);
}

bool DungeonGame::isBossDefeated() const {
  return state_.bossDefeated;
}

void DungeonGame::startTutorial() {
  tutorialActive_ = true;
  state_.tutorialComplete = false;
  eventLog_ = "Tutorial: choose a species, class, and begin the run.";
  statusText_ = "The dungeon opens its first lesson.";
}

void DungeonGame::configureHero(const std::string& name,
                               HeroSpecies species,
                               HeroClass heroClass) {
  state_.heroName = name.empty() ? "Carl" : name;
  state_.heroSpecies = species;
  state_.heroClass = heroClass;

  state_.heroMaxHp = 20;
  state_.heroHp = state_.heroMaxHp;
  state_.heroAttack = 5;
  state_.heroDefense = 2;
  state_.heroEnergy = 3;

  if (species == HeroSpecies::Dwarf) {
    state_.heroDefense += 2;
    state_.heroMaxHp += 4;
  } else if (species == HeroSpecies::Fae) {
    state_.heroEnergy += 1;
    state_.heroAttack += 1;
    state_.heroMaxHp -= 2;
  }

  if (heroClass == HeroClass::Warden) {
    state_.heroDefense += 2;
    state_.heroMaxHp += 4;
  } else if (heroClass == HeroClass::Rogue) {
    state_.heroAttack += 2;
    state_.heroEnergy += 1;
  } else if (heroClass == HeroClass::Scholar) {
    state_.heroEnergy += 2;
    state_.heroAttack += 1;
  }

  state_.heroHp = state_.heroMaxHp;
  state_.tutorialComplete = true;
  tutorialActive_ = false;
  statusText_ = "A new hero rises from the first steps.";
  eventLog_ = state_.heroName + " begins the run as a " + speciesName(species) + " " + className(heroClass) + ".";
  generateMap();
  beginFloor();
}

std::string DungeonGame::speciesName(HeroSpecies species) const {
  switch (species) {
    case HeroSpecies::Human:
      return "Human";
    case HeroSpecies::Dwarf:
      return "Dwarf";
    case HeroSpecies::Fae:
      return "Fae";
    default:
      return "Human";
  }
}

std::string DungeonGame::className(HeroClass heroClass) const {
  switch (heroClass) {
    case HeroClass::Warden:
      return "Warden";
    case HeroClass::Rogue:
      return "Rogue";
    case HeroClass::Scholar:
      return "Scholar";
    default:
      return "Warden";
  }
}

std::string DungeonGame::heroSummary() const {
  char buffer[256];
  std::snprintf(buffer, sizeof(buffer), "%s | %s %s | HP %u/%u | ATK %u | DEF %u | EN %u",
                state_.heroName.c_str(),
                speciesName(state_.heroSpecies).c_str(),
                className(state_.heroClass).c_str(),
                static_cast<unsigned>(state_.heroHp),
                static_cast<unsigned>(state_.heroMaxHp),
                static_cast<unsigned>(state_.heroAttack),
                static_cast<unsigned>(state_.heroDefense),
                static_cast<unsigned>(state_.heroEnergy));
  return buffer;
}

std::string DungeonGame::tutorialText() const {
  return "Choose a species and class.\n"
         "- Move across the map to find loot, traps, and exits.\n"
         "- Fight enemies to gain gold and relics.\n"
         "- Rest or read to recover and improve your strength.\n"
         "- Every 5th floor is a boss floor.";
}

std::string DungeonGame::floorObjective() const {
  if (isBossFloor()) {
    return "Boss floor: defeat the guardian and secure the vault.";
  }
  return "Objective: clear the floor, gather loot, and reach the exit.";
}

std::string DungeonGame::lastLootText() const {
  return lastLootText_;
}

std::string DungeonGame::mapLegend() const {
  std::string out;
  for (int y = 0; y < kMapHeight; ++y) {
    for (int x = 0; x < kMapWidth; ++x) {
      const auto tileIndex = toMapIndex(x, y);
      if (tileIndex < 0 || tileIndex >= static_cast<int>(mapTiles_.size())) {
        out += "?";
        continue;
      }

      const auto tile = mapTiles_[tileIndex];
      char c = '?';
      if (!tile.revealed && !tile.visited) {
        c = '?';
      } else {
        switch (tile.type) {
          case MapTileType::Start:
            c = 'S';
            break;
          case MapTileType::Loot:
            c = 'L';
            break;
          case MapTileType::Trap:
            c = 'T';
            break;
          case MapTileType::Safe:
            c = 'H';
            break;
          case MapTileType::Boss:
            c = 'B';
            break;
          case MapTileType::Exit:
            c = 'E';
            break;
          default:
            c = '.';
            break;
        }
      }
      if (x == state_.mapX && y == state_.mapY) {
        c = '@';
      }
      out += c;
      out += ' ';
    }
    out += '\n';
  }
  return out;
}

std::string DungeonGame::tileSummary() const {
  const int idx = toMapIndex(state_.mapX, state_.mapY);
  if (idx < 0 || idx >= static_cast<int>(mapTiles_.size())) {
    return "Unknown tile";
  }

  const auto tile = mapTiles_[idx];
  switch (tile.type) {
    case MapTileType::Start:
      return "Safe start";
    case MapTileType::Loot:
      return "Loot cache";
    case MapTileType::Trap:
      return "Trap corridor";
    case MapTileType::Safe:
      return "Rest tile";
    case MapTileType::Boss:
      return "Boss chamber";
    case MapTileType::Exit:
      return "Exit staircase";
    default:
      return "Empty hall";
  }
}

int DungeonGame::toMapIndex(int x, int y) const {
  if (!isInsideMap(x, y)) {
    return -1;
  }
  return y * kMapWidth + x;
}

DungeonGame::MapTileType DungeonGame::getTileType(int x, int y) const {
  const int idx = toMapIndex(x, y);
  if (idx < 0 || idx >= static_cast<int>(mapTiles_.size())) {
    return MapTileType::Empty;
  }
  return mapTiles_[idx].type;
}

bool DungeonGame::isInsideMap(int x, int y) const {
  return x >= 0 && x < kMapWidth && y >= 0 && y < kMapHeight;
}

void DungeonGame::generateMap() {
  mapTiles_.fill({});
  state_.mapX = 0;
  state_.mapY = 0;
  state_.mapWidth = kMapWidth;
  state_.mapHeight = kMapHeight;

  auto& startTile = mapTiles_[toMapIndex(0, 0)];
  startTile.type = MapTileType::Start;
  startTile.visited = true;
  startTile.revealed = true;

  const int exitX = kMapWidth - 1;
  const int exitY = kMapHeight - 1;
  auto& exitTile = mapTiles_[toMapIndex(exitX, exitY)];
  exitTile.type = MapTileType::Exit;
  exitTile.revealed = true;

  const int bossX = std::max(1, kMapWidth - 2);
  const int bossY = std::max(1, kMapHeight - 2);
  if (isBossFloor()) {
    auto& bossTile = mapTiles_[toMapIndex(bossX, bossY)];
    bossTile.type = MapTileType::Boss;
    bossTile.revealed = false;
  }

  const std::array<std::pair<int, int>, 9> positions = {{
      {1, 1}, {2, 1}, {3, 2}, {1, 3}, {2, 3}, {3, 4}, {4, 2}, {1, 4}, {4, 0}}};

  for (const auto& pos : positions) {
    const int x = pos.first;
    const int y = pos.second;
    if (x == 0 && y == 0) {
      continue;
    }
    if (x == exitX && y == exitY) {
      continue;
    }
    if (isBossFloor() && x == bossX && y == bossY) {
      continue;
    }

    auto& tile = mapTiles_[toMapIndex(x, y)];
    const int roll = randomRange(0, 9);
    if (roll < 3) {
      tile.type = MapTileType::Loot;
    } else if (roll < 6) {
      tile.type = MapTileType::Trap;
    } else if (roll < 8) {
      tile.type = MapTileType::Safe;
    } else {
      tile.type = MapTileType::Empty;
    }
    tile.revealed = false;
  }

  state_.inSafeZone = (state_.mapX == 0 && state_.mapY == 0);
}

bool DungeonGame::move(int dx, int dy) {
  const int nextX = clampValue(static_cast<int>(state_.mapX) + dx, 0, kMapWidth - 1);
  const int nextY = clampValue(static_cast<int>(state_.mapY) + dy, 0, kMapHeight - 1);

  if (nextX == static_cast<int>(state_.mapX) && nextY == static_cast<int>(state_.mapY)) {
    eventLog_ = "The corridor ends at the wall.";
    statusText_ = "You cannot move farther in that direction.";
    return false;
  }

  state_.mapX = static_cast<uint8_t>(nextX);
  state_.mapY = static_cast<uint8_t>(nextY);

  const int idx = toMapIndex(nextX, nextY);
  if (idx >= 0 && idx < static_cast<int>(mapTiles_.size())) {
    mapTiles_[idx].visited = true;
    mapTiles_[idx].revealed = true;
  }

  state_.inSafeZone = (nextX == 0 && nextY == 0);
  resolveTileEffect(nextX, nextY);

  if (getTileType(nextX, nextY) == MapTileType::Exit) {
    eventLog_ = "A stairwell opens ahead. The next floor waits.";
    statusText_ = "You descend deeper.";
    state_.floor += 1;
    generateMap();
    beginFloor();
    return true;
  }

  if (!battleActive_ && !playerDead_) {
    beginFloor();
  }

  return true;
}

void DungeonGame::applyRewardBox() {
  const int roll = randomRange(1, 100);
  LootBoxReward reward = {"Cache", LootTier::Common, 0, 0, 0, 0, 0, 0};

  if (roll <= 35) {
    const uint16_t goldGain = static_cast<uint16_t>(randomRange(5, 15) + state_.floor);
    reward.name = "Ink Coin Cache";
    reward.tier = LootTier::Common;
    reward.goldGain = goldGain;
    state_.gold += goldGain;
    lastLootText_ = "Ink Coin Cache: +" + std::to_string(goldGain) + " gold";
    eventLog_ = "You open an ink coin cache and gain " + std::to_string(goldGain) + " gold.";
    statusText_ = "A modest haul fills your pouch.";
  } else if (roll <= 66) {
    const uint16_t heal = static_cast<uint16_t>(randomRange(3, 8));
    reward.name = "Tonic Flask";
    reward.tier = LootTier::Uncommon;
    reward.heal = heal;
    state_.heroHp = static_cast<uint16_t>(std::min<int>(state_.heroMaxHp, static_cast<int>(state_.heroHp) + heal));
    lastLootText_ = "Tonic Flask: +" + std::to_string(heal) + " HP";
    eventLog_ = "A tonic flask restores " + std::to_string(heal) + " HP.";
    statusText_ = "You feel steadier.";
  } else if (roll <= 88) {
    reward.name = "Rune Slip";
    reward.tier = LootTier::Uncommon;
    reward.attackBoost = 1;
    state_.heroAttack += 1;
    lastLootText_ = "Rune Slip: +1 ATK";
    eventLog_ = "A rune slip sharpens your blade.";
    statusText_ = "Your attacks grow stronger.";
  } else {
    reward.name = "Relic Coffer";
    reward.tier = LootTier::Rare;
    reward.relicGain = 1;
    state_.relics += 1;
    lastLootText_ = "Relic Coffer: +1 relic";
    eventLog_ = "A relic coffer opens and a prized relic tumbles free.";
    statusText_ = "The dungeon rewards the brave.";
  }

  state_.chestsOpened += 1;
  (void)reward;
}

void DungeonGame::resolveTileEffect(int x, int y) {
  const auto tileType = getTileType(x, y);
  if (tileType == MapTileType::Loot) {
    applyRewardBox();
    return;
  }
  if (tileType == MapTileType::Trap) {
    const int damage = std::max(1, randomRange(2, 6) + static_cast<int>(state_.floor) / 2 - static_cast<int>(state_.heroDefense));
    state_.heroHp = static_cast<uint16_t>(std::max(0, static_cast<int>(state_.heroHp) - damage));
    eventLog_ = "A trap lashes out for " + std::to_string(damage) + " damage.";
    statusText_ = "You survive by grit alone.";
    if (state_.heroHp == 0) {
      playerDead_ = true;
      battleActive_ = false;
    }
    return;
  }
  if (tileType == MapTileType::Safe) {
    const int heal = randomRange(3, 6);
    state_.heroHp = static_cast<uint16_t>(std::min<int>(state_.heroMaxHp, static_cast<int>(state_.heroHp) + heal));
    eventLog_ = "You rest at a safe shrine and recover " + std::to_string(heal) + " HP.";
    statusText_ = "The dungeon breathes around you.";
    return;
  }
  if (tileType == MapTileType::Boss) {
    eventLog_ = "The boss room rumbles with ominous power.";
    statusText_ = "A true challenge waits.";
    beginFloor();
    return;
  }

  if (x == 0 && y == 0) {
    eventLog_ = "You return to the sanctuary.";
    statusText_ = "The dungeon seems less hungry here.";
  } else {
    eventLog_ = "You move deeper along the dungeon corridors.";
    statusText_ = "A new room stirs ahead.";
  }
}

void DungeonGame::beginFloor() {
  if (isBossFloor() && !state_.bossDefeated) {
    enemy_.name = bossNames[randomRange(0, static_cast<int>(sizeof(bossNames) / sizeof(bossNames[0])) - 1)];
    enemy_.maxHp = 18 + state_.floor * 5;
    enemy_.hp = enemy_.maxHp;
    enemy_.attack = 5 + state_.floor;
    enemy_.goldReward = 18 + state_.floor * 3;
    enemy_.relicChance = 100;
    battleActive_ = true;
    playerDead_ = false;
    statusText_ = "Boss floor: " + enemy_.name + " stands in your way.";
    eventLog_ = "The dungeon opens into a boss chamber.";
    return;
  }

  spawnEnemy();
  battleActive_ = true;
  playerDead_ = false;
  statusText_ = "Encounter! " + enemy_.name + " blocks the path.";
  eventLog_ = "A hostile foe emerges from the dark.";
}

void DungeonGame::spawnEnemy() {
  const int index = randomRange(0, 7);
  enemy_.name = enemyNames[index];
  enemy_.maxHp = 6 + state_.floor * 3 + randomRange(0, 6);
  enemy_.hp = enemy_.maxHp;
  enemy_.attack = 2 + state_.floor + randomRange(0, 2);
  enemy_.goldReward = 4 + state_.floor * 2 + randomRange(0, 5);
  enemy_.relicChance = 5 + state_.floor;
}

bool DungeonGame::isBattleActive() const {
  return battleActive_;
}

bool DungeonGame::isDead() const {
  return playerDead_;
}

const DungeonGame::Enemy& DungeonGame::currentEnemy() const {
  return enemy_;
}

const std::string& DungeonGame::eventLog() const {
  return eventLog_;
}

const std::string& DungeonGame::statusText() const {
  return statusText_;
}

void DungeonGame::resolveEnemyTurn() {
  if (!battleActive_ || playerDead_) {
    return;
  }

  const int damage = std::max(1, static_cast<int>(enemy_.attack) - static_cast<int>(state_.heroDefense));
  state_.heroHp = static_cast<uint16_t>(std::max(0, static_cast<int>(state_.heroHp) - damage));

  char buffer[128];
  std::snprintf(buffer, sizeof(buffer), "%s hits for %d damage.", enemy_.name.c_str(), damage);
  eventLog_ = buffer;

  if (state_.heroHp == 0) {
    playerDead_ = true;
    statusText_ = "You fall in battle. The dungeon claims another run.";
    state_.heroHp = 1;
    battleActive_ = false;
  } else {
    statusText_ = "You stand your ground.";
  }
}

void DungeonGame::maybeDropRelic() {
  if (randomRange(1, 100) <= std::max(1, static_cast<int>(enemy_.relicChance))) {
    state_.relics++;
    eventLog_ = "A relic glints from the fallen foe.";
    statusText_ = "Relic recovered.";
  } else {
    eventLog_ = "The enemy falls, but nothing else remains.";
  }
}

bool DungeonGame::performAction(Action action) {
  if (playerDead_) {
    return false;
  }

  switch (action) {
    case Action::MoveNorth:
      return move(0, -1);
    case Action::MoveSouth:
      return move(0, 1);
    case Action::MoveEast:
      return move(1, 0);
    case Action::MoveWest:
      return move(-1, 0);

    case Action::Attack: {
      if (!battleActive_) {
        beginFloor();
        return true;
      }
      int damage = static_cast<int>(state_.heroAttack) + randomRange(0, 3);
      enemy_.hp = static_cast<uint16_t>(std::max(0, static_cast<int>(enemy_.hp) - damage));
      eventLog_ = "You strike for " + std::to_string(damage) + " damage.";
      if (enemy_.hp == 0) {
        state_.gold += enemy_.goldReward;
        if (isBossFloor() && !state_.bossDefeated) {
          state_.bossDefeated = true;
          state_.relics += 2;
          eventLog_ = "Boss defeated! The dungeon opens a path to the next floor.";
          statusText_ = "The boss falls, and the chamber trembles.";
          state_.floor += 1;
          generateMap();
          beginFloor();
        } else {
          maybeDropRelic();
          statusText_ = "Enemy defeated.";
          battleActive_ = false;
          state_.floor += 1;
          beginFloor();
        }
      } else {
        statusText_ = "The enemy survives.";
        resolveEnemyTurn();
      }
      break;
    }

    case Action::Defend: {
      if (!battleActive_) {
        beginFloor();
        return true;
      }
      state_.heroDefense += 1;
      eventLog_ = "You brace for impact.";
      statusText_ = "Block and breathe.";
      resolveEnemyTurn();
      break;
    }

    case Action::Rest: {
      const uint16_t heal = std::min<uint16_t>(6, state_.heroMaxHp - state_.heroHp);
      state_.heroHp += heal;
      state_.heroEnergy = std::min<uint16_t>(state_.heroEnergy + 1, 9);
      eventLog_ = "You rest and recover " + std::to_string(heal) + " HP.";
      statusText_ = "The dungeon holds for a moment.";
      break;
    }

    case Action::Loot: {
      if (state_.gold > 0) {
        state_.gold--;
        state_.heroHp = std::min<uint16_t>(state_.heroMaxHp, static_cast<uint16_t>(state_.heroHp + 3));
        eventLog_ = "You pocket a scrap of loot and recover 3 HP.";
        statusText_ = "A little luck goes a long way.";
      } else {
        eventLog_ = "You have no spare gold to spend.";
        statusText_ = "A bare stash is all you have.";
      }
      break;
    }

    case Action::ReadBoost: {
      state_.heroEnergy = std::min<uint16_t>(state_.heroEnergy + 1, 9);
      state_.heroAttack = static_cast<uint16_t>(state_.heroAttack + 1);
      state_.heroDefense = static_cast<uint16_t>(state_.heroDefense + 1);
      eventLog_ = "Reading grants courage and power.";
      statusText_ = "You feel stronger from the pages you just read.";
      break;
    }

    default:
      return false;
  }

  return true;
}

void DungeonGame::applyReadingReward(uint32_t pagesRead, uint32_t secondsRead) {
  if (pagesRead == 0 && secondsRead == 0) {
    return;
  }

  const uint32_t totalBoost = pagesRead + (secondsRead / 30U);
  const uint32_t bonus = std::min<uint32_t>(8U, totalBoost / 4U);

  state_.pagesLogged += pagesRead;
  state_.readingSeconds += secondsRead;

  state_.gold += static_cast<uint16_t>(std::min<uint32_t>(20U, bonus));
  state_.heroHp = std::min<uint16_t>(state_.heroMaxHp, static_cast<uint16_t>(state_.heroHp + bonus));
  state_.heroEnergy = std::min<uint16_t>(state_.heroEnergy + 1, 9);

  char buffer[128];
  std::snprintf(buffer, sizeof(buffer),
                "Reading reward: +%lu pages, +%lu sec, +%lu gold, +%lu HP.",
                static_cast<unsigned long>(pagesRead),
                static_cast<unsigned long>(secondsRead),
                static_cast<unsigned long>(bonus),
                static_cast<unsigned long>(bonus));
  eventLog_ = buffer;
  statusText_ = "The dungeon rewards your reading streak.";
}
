#pragma once

#include <algorithm>
#include <array>
#include <stdint.h>
#include <string>

class DungeonGame {
 public:
  enum class Action {
    Attack,
    Defend,
    Rest,
    Loot,
    ReadBoost,
    MoveNorth,
    MoveSouth,
    MoveEast,
    MoveWest
  };

  enum class HeroSpecies {
    Human,
    Dwarf,
    Fae
  };

  enum class HeroClass {
    Warden,
    Rogue,
    Scholar
  };

  enum class MapTileType {
    Empty,
    Start,
    Loot,
    Trap,
    Safe,
    Boss,
    Exit
  };

  enum class LootTier {
    Common,
    Uncommon,
    Rare
  };

  struct Enemy {
    std::string name;
    uint16_t hp = 0;
    uint16_t maxHp = 0;
    uint16_t attack = 0;
    uint16_t goldReward = 0;
    uint16_t relicChance = 0;
  };

  struct MapTile {
    MapTileType type = MapTileType::Empty;
    bool visited = false;
    bool revealed = false;
  };

  struct LootBoxReward {
    std::string name;
    LootTier tier = LootTier::Common;
    uint16_t goldGain = 0;
    uint16_t heal = 0;
    uint16_t attackBoost = 0;
    uint16_t defenseBoost = 0;
    uint16_t relicGain = 0;
    uint16_t potionGain = 0;
  };

  struct SaveState {
    uint16_t floor = 1;
    uint16_t heroHp = 20;
    uint16_t heroMaxHp = 20;
    uint16_t heroAttack = 5;
    uint16_t heroDefense = 2;
    uint16_t heroEnergy = 3;
    uint16_t gold = 0;
    uint16_t relics = 0;
    uint32_t pagesLogged = 0;
    uint32_t readingSeconds = 0;

    std::string heroName = "Carl";
    HeroSpecies heroSpecies = HeroSpecies::Human;
    HeroClass heroClass = HeroClass::Warden;
    bool tutorialComplete = false;
    bool inSafeZone = false;
    bool bossDefeated = false;

    uint8_t mapWidth = 5;
    uint8_t mapHeight = 5;
    uint8_t mapX = 0;
    uint8_t mapY = 0;
    uint16_t lootKeys = 0;
    uint16_t potions = 0;
    uint16_t chestsOpened = 0;
  };

  DungeonGame();
  void reset();
  void loadFromSave(const SaveState& state);
  SaveState save() const;

  void beginFloor();
  void generateMap();
  bool move(int dx, int dy);
  void configureHero(const std::string& name,
                    HeroSpecies species,
                    HeroClass heroClass);
  void startTutorial();
  void applyReadingReward(uint32_t pagesRead, uint32_t secondsRead);
  bool performAction(Action action);

  bool isBattleActive() const;
  bool isDead() const;
  bool isTutorialComplete() const;
  bool isBossFloor() const;
  bool isBossDefeated() const;
  const Enemy& currentEnemy() const;
  const std::string& eventLog() const;
  const std::string& statusText() const;
  std::string mapLegend() const;
  std::string tileSummary() const;
  std::string heroSummary() const;
  std::string tutorialText() const;
  std::string floorObjective() const;
  std::string speciesName(HeroSpecies species) const;
  std::string className(HeroClass heroClass) const;
  std::string lastLootText() const;

 private:
  SaveState state_;
  Enemy enemy_;
  bool battleActive_ = false;
  bool playerDead_ = false;
  std::string statusText_;
  std::string eventLog_;
  std::string lastLootText_;
  uint32_t floorProgress_ = 0;
  bool tutorialActive_ = false;
  std::array<MapTile, 25> mapTiles_{};
  static constexpr int kMapWidth = 5;
  static constexpr int kMapHeight = 5;

  int toMapIndex(int x, int y) const;
  MapTileType getTileType(int x, int y) const;
  bool isInsideMap(int x, int y) const;
  void spawnEnemy();
  void resolveEnemyTurn();
  void maybeDropRelic();
  void resolveTileEffect(int x, int y);
  void applyRewardBox();
  static int randomRange(int minInclusive, int maxInclusive);
};
